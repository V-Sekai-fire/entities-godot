+
+namespace tint::core::ir {
+class Module;
+}
+
+namespace tint::spirv::reader::lower {
+
+/// Godot: replaces every function parameter that is a pointer to a texture or sampler with the
+/// module-scope variable the caller passes, making one copy of the function per distinct set of
+/// variables. Texture lowering then sees the variables themselves, which depth comparison
+/// sampling needs to turn a texture into a depth texture and a sampler into a comparison sampler.
+/// @param module the module to transform
+/// @returns success or failure
+Result<SuccessType> HandleParams(core::ir::Module& module);
+
+}  // namespace tint::spirv::reader::lower
+
+#endif  // SRC_TINT_LANG_SPIRV_READER_LOWER_HANDLE_PARAMS_H_
