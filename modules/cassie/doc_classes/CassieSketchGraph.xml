		<method name="add_stroke_intersecting">
			<return type="int" />
			<param index="0" name="points" type="PackedVector3Array" />
			<param index="1" name="normals" type="PackedVector3Array" />
			<param index="2" name="proximity" type="float" />
			<param index="3" name="boundary" type="bool" default="false" />
			<description>
				Adds one stroke and splits it, and every existing edge it crosses within [param proximity], at the crossings. Untouched edges keep their ids. Returns the number of edges added. Stretches beside a knot where two strokes' ends meet merge at the knot instead of splitting as T-junctions. If [param boundary] is [code]true[/code], the stroke's edges are marked boundary edges (see [method is_opening]).
			</description>
		</method>
