#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

# Foundation module for RFD 2242. Vendors 2-contract/ggml under
# #thirdparty/ggml/ as the single ggml source workspace-wide (RFD 2188).
# The heavy per-platform source graph (Metal / Vulkan / WebGPU builders,
# per-arch collision map) comes from turboquant-godot/modules/llm/SCsub
# and lands in a follow-up PR that imports the vendored tree — this
# initial SCsub is the module skeleton so the parse is clean.

env_ggml = env_modules.Clone()

tp = "#thirdparty/ggml/"
env_ggml.Prepend(CPPPATH=[
    tp + "include",
    tp + "src",
    tp + "src/ggml-cpu",
])

# Placeholder for the vendored source list. The follow-up import PR
# populates thirdparty/ggml/ and this list.
ggml_thirdparty_sources = []

module_obj = []
env_ggml.add_source_files(module_obj, "*.cpp")
env.modules_sources += module_obj

if ggml_thirdparty_sources:
    env_thirdparty = env_ggml.Clone()
    env_thirdparty.disable_warnings()
    thirdparty_obj = []
    env_thirdparty.add_source_files(thirdparty_obj, ggml_thirdparty_sources)
    env.modules_sources += thirdparty_obj
    env.Depends(module_obj, thirdparty_obj)
