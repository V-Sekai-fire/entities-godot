FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq clang lld libc++-dev libc++abi-dev cmake ninja-build python3 python3-jinja2 libssl-dev zlib1g-dev liblz4-dev git curl ca-certificates pkg-config xz-utils >/dev/null && rm -rf /var/lib/apt/lists/*
