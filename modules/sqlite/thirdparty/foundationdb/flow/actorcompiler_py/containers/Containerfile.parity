FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq mono-mcs mono-runtime libmono-system-core4.0-cil libmono-system-xml-linq4.0-cil libmono-system-data-datasetextensions4.0-cil libmono-microsoft-csharp4.0-cil libmono-system-data4.0-cil python3 >/dev/null && rm -rf /var/lib/apt/lists/*
