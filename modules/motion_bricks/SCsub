#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

# RFD 2242. Stacks on modules/ggml/ at the C++ #include level.
# wraps motion-bricks-cpp (motionbricks.h C ABI). Generates an animation from a movement/facing/target command.
# The `#thirdparty/motion_bricks/` tree vendors the upstream source via
# scripts/import_module_source.py and lands in a follow-up PR.

env_motion_bricks = env_modules.Clone()

tp = "#thirdparty/motion_bricks/"
env_motion_bricks.Prepend(CPPPATH=[
    tp + "include",
    "#modules/ggml",
])

motion_bricks_thirdparty_sources = []

module_obj = []
env_motion_bricks.add_source_files(module_obj, "*.cpp")
env.modules_sources += module_obj

if motion_bricks_thirdparty_sources:
    env_thirdparty = env_motion_bricks.Clone()
    env_thirdparty.disable_warnings()
    thirdparty_obj = []
    env_thirdparty.add_source_files(thirdparty_obj, motion_bricks_thirdparty_sources)
    env.modules_sources += thirdparty_obj
    env.Depends(module_obj, thirdparty_obj)
