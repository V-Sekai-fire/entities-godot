#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

# RFD 2242. Stacks on modules/ggml/ at the C++ #include level.
# wraps skin-tokens-cpp (skintokens.h C ABI). Retargets a source motion onto a humanoid rig described by the GLB bytes.
# The `#thirdparty/skin_tokens/` tree vendors the upstream source via
# scripts/import_module_source.py and lands in a follow-up PR.

env_skin_tokens = env_modules.Clone()

tp = "#thirdparty/skin_tokens/"
env_skin_tokens.Prepend(
    CPPPATH=[
        tp + "include",
        "#modules/ggml",
    ]
)

skin_tokens_thirdparty_sources = []

module_obj = []
env_skin_tokens.add_source_files(module_obj, "*.cpp")
env.modules_sources += module_obj

if skin_tokens_thirdparty_sources:
    env_thirdparty = env_skin_tokens.Clone()
    env_thirdparty.disable_warnings()
    thirdparty_obj = []
    env_thirdparty.add_source_files(thirdparty_obj, skin_tokens_thirdparty_sources)
    env.modules_sources += thirdparty_obj
    env.Depends(module_obj, thirdparty_obj)
