#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

# RFD 2242. Stacks on modules/ggml/ at the C++ #include level.
# wraps rf-detr-cpp via its rfdetr_capi.{h,cpp} (added in a paired PR to V-Sekai-fire/rf-detr-cpp). Returns detected boxes and keypoints.
# The `#thirdparty/rf_detr/` tree vendors the upstream source via
# scripts/import_module_source.py and lands in a follow-up PR.

env_rf_detr = env_modules.Clone()

tp = "#thirdparty/rf_detr/"
env_rf_detr.Prepend(
    CPPPATH=[
        tp + "include",
        "#modules/ggml",
    ]
)

rf_detr_thirdparty_sources = []

module_obj = []
env_rf_detr.add_source_files(module_obj, "*.cpp")
env.modules_sources += module_obj

if rf_detr_thirdparty_sources:
    env_thirdparty = env_rf_detr.Clone()
    env_thirdparty.disable_warnings()
    thirdparty_obj = []
    env_thirdparty.add_source_files(thirdparty_obj, rf_detr_thirdparty_sources)
    env.modules_sources += thirdparty_obj
    env.Depends(module_obj, thirdparty_obj)
